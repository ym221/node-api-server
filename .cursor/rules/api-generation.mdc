### 3️⃣ `types.ts` - 类型定义

```typescript
// 数据实体（对应数据库表结构）
export interface ExampleItem {
  id: number;
  name: string;
  description?: string;
  status: number;
  sort_order: number;
  created_at: Date;
  updated_at: Date;
}

// 列表查询参数
export interface ExampleListQuery {
  page?: number;
  pageSize?: number;
  status?: number;
  keyword?: string;
}

// 创建 DTO
export interface ExampleCreateDto {
  name: string;
  description?: string;
  status?: number;
  sort_order?: number;
}

// 更新 DTO（所有字段都是可选）
export interface ExampleUpdateDto {
  name?: string;
  description?: string;
  status?: number;
  sort_order?: number;
}
```

