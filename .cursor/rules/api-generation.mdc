### 8️⃣ `init-db.ts` - 数据库初始化脚本

```typescript
import fs from 'fs';
import path from 'path';
import { execute, insert } from '../../config/database';

async function initDatabase() {
  try {
    console.log('开始初始化[模块名]数据库...');

    // ⚠️ 使用 process.cwd() 而不是 __dirname
    const schemaPath = path.join(process.cwd(), 'src/generated/[模块名]/schema.sql');
    const schemaSql = fs.readFileSync(schemaPath, 'utf-8');
    
    // 先按行过滤注释，再分割 SQL 语句
    const sqlWithoutComments = schemaSql
      .split('\n')
      .filter(line => !line.trim().startsWith('--'))
      .join('\n');
    
    const statements = sqlWithoutComments
      .split(';')
      .map(s => s.trim())
      .filter(s => s.length > 0);

    console.log(`找到 ${statements.length} 条 SQL 语句`);
    
    for (let i = 0; i < statements.length; i++) {
      console.log(`执行第 ${i + 1} 条 SQL...`);
      await execute(statements[i]);
    }

    console.log('✅ 数据表创建成功');

    // 插入测试数据
    console.log('正在插入测试数据...');
    // 使用 insert() 函数插入测试数据
    // 确保插入足够的测试数据，供验证脚本使用

    console.log('🎉 [模块名]初始化完成！');
    process.exit(0);
  } catch (error) {
    console.error('❌ 数据库初始化失败:', error);
    process.exit(1);
  }
}

initDatabase();
```

**关键点**：
- ✅ 必须使用 `execute` 和 `insert` 函数，不是 `db.query`
- ✅ 使用 `process.cwd()` 获取工作目录，不要用 `__dirname`
- ✅ 必须插入足够的测试数据，确保验证脚本能够使用
- ✅ 运行方式：`npx tsx src/generated/[模块名]/init-db.ts`

