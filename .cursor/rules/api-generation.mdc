### 9️⃣ `verify.ts` - 验证脚本

**用途**：自动验证生成的接口和后台管理功能是否可用

**核心原则**：
- ✅ 验证目的是确认"代码能否执行"，而不是测试复杂度
- ✅ 只验证 1 个接口 + 1 个后台功能
- ✅ 如果验证失败，说明规则有问题，需要优化规则

```typescript
import axios from 'axios';
import { moduleConfig } from './module.config';

const BASE_URL = process.env.API_BASE_URL || 'http://localhost:8090';

/**
 * 智能选择要验证的接口
 * 优先选择可以独立执行的接口
 */
function selectInterfaceToVerify() {
  const interfaces = moduleConfig.interfaces;
  
  // 1. 优先选择列表接口（最安全，即使没数据也能返回空列表）
  let target = interfaces.find(i => 
    i.method === 'GET' && 
    (i.path.includes('/list') || i.description.includes('列表'))
  );
  
  // 2. 其次选择创建接口（可以独立执行，不依赖现有数据）
  if (!target) {
    target = interfaces.find(i => 
      i.method === 'POST' && 
      (i.path.includes('/create') || i.description.includes('创建') || i.description.includes('新增'))
    );
  }
  
  // 3. 选择不带路径参数的 GET 接口
  if (!target) {
    target = interfaces.find(i => 
      i.method === 'GET' && 
      !i.path.includes(':')
    );
  }
  
  // 4. 选择不带路径参数的 POST 接口
  if (!target) {
    target = interfaces.find(i => 
      i.method === 'POST' && 
      !i.path.includes(':')
    );
  }
  
  // 5. 最后选择第一个接口（可能需要依赖 init-db.ts 的测试数据）
  if (!target) {
    target = interfaces[0];
  }
  
  return target;
}

/**
 * 构建完整 URL
 */
function buildUrl(path: string): string {
  return `${BASE_URL}${path}`;
}

/**
 * 根据接口信息生成测试数据
 * ⚠️ AI 在生成时应该根据实际的接口需求填充此函数
 */
function generateTestData(interfaceInfo: any): any {
  // 根据模块类型返回对应的测试数据
  // ⚠️ AI 生成时必须根据实际接口需求填充
  return {};
}

/**
 * 验证接口
 */
async function verifyInterface(interfaceInfo: any): Promise<boolean> {
  try {
    console.log(`   路径: ${interfaceInfo.method} ${interfaceInfo.path}`);
    console.log(`   描述: ${interfaceInfo.description}`);
    
    let response;
    const url = buildUrl(interfaceInfo.path);
    
    if (interfaceInfo.method === 'GET') {
      if (interfaceInfo.path.includes(':id')) {
        const testUrl = url.replace(':id', '1');
        response = await axios.get(testUrl);
      } else {
        response = await axios.get(url);
      }
      
    } else if (interfaceInfo.method === 'POST') {
      const testData = generateTestData(interfaceInfo);
      response = await axios.post(url, testData);
      
    } else if (interfaceInfo.method === 'PUT') {
      const testData = generateTestData(interfaceInfo);
      if (interfaceInfo.path.includes(':id')) {
        const testUrl = url.replace(':id', '1');
        response = await axios.put(testUrl, testData);
      } else {
        response = await axios.put(url, testData);
      }
      
    } else if (interfaceInfo.method === 'DELETE') {
      if (interfaceInfo.path.includes(':id')) {
        const testUrl = url.replace(':id', '1');
        response = await axios.delete(testUrl);
      } else {
        response = await axios.delete(url);
      }
    }
    
    // 验证响应格式
    if (response && response.data) {
      const hasValidFormat = 
        (response.data.success !== undefined && response.data.code !== undefined) || // B2B/Ebooking
        (response.data.Success !== undefined && response.data.Code !== undefined);   // ERP
      
      if (hasValidFormat) {
        console.log('   ✅ 接口可以执行，响应格式正确');
        return true;
      } else {
        console.log('   ❌ 接口响应格式错误');
        console.log('   响应数据:', JSON.stringify(response.data, null, 2));
        return false;
      }
    }
    
    return false;
    
  } catch (error: any) {
    console.log('   ❌ 接口执行失败');
    console.log('   错误信息:', error.response?.data?.message || error.message);
    
    if (error.response?.status === 404) {
      console.log('   说明：路由未注册或路径错误');
    } else if (error.response?.status === 500) {
      console.log('   说明：服务器内部错误，可能是代码逻辑问题');
    }
    
    return false;
  }
}

/**
 * 验证后台管理集成
 */
async function verifyAdminIntegration(): Promise<boolean> {
  try {
    const response = await axios.get(`${BASE_URL}/api/_admin/modules`);
    const moduleExists = response.data.data?.some((m: any) => m.name === moduleConfig.name);
    
    if (moduleExists) {
      console.log('   ✅ 模块已被后台识别');
      return true;
    } else {
      console.log('   ❌ 模块未被识别');
      console.log('   说明：module.config.ts 可能未正确导出或服务器未重启');
      return false;
    }
    
  } catch (error: any) {
    console.log('   ❌ 无法访问后台管理接口');
    console.log('   错误信息:', error.message);
    return false;
  }
}

/**
 * 主验证函数
 */
async function verify() {
  console.log('🔍 开始验证模块功能...\n');
  console.log(`模块名称: ${moduleConfig.description} (${moduleConfig.name})`);
  console.log(`接口数量: ${moduleConfig.interfaces.length} 个\n`);
  
  let allPassed = true;
  
  // 1. 验证接口
  console.log('1️⃣ 验证接口功能...');
  const targetInterface = selectInterfaceToVerify();
  console.log(`   选择验证: ${targetInterface.description}`);
  
  const interfacePassed = await verifyInterface(targetInterface);
  if (!interfacePassed) {
    allPassed = false;
    console.log('\n⚠️  接口验证失败，说明生成的代码有问题');
    console.log('   建议：检查并优化规则，重新生成模块\n');
  }
  
  // 2. 验证后台管理集成
  console.log('\n2️⃣ 验证后台管理集成...');
  const adminPassed = await verifyAdminIntegration();
  if (!adminPassed) {
    allPassed = false;
  }
  
  // 3. 输出验证结果
  console.log('\n' + '='.repeat(50));
  if (allPassed) {
    console.log('✅ 验证通过！模块可用。');
    console.log('🎨 管理后台: http://localhost:8090/admin');
    console.log('📝 模块文档: src/generated/' + moduleConfig.name + '/.prompt.md');
  } else {
    console.log('❌ 验证失败！请检查上述错误信息。');
    console.log('⚠️  如果多个功能都失败，说明规则有问题，需要优化规则。');
  }
  console.log('='.repeat(50));
  
  process.exit(allPassed ? 0 : 1);
}

verify();
```

**关键点**：
- ✅ 智能选择接口：优先选择可以独立执行的接口（列表、创建）
- ✅ generateTestData 必须根据实际接口需求填充
- ✅ 处理路径参数：如果接口需要 `:id`，使用测试数据（ID 通常为 1）
- ✅ 响应格式兼容：支持 B2B/Ebooking 和 ERP 两种格式
- ✅ 运行方式：`npx tsx src/generated/[模块名]/verify.ts`
- ✅ **AI 在生成完所有文件后，必须自动运行此脚本**

