### 3️⃣ `types.ts` - 类型定义

**基础结构**：
```typescript
/**
 * 数据实体（对应数据库表结构）
 */
export interface ExampleItem {
  id: number;
  name: string;
  description?: string;
  status: number;
  sort_order: number;
  created_at: Date;
  updated_at: Date;
  // ... 其他业务字段
}

/**
 * 列表查询参数
 */
export interface ExampleListQuery {
  page?: number;
  pageSize?: number;
  status?: number;
  keyword?: string;
  // ... 其他筛选字段
}

/**
 * 创建 DTO
 */
export interface ExampleCreateDto {
  name: string;
  description?: string;
  status?: number;
  sort_order?: number;
  // ... 其他可创建字段
}

/**
 * 更新 DTO
 */
export interface ExampleUpdateDto {
  name?: string;
  description?: string;
  status?: number;
  sort_order?: number;
  // ... 其他可更新字段（所有字段都是可选）
}
```

