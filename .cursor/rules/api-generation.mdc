### 4️⃣ `model.ts` - 数据模型

**基础结构**：
```typescript
import { BaseModel } from '../../core/BaseModel';
import { ExampleItem, ExampleListQuery } from './types';

export class ExampleModel extends BaseModel<ExampleItem> {
  constructor() {
    super('example_table');
  }

  /**
   * 查询列表（带搜索和筛选）
   */
  async findList(query: ExampleListQuery) {
    const { page = 1, pageSize = 20, status, keyword } = query;

    let whereClauses: string[] = [];
    let params: any[] = [];

    // 状态筛选
    if (status !== undefined) {
      whereClauses.push('status = ?');
      params.push(status);
    }

    // 关键词搜索
    if (keyword) {
      whereClauses.push('(name LIKE ? OR description LIKE ?)');
      params.push(`%${keyword}%`, `%${keyword}%`);
    }

    // 构建 WHERE 子句
    const whereClause = whereClauses.length > 0 
      ? ` WHERE ${whereClauses.join(' AND ')}` 
      : '';

    // 查询总数
    const countSql = `SELECT COUNT(*) as total FROM ${this.tableName}${whereClause}`;
    const countResult = await this.rawQueryOne<{ total: number }>(
      countSql, 
      params.length > 0 ? params : undefined
    );
    const total = countResult?.total || 0;

    // 查询数据
    const limit = Math.min(pageSize, 100);
    const offset = (page - 1) * limit;
    
    // ⚠️ 重要：LIMIT 和 OFFSET 必须直接拼接到 SQL 中，不能用 ? 占位符
    // 原因：MySQL 的预处理语句不支持 LIMIT/OFFSET 使用占位符
    const dataSql = `SELECT * FROM ${this.tableName}${whereClause} ORDER BY sort_order DESC, id DESC LIMIT ${limit} OFFSET ${offset}`;
    
    const list = await this.rawQuery<ExampleItem>(
      dataSql, 
      params.length > 0 ? params : undefined
    );

    return {
      list,
      total,
      page,
      pageSize: limit,
    };
  }
}
```

**关键注意事项**：
- ✅ **LIMIT 和 OFFSET 必须直接拼接**，不能用 `?` 占位符
- ✅ **params 为空数组时，传 `undefined` 而不是空数组**
- ✅ 继承自 `BaseModel`，可使用 `findById`, `create`, `update`, `delete` 等方法
- ✅ 如果有复杂业务逻辑，可添加自定义方法（如 `updateStock`, `batchDelete` 等）

