# ====================================
# API 测试服务器 - 环境配置模板
# ====================================
# 说明：
# 1. 复制此文件为 .env
# 2. 修改下面的配置值
# 3. 不要提交 .env 到 Git
# ====================================

# -------------------------------------
# 服务器配置
# -------------------------------------
# 服务器监听端口（默认: 8088）
PORT=8088

# 运行环境（development 或 production）
NODE_ENV=development

# -------------------------------------
# 数据库配置（MySQL）
# -------------------------------------
# 数据库主机地址
DB_HOST=localhost

# 数据库端口（MySQL 默认: 3306）
DB_PORT=3306

# 数据库用户名
DB_USER=root

# 数据库密码（必填！请修改为您的 MySQL 密码）
DB_PASSWORD=

# 数据库名称（如果不存在会自动创建）
DB_NAME=api_test_server

# -------------------------------------
# CORS 跨域配置
# -------------------------------------
# 允许的来源（* 表示允许所有来源，生产环境建议指定具体域名）
CORS_ORIGIN=*

# -------------------------------------
# 文件上传配置
# -------------------------------------
# 文件上传目录（相对路径）
UPLOAD_DIR=./uploads

# 最大文件大小（字节，默认: 10MB = 10485760 字节）
MAX_FILE_SIZE=10485760

# -------------------------------------
# 日志配置
# -------------------------------------
# 日志级别（debug | info | warn | error）
# 开发环境建议: debug
# 生产环境建议: info
LOG_LEVEL=debug

# 日志保存目录（相对路径）
LOG_DIR=./logs

# ====================================
# 配置完成后的检查清单：
# ====================================
# [ ] 已设置 DB_PASSWORD（MySQL 密码）
# [ ] 确认 MySQL 服务正在运行
# [ ] 确认端口 8088 未被占用
# [ ] 运行 npm run db:init 初始化数据库
# [ ] 运行 npm run dev 启动服务器
# ====================================

